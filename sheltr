        raise HTTPException(status_code=400, detail="Category name required")
    with get_db() as conn:
        conn.execute(
            "INSERT OR REPLACE INTO media_types (name, color) VALUES (?, ?)",
            (clean, payload.color or "#818cf8"),
        )
    return {"name": clean, "color": payload.color or "#818cf8"}


@app.patch("/api/media-types/{name}")
