    with get_db() as conn:
        conn.execute("DELETE FROM media_types WHERE name = ?", (name,))
    return {"ok": True}


@app.get("/api/tags")
def list_tags(
    q: str = "",
    media_type: str = "",
    status: str = "ALL",
    rating: int = -1,
    tag: str = "",
):
    with get_db() as conn:
        if not q.strip() and status == "ALL" and rating < 0 and not tag.strip():
            return get_tag_counts(conn, media_type)

        matching = query_filtered_entries(
            conn,
            q=q,
            media_type=media_type or "ALL",
            status=status,
            rating=rating,
            tag=tag,
        )

    counts: dict[str, int] = {}
    for entry in matching:
        for t in entry["tags"]:
            tl = t.strip().lower()
            if tl:
                counts[tl] = counts.get(tl, 0) + 1

    return [
        {"name": k, "count": v}
        for k, v in sorted(counts.items(), key=lambda kv: (-kv[1], kv[0]))
    ]


