@app.post("/api/backup")
def create_backup():
    stamp = datetime.now().strftime("%Y%m%d_%H%M%S")
    zip_name = f"sheltr_vault_{stamp}.zip"
    zip_path = BACKUPS_DIR / zip_name
    seen_arcnames: set[str] = set()
    with zipfile.ZipFile(zip_path, "w", zipfile.ZIP_DEFLATED) as zf:
        if DB_PATH.exists():
            zf.write(DB_PATH, arcname="sheltr.db")
        for media_dir in MEDIA_SEARCH_DIRS:
            if not media_dir.exists():
                continue
            for img in media_dir.iterdir():
                if img.is_file():
                    arcname = f"vault_media/{img.name}"
                    if arcname not in seen_arcnames:
                        zf.write(img, arcname=arcname)
                        seen_arcnames.add(arcname)
    return {"db_backup": zip_name}


