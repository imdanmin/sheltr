def get_meta_column(conn: sqlite3.Connection) -> str:
    cols = get_column_names(conn, "entries")
    return "metadata_json" if "metadata_json" in cols else "metadata"


def get_entry_tags(conn: sqlite3.Connection, row: sqlite3.Row) -> list[str]:
    tables = get_table_names(conn)
    entry_cols = get_column_names(conn, "entries")

    if "entry_tags" in tables:
        et_cols = get_column_names(conn, "entry_tags")
        if "tag_id" in et_cols and "tags" in tables:
            tag_rows = conn.execute(
                """
                SELECT t.name
                FROM tags t
                JOIN entry_tags et ON et.tag_id = t.id
                WHERE et.entry_id = ?
                ORDER BY t.name ASC
                """,
                (row["id"],),
            ).fetchall()
            return [r["name"] for r in tag_rows if r["name"]]
        tag_col = "tag_name" if "tag_name" in et_cols else ("tag" if "tag" in et_cols else None)
        if tag_col:
            tag_rows = conn.execute(
                f"SELECT {tag_col} AS name FROM entry_tags WHERE entry_id = ? ORDER BY {tag_col} ASC",
                (row["id"],),
            ).fetchall()
            return [r["name"] for r in tag_rows if r["name"]]

    if "tags" in entry_cols:
        raw = row["tags"]
        if isinstance(raw, list):
            return raw
        try:
            parsed = json.loads(raw or "[]")
            return parsed if isinstance(parsed, list) else []
        except Exception:
            return []

    return []


def set_entry_tags(conn: sqlite3.Connection, entry_id: str, clean_tags: list[str]) -> None:
    tables = get_table_names(conn)
    entry_cols = get_column_names(conn, "entries")

    if "entry_tags" in tables:
        et_cols = get_column_names(conn, "entry_tags")
        conn.execute("DELETE FROM entry_tags WHERE entry_id = ?", (entry_id,))
        if "tag_id" in et_cols and "tags" in tables:
            for t in clean_tags:
                conn.execute("INSERT OR IGNORE INTO tags (name) VALUES (?)", (t,))
                t_row = conn.execute("SELECT id FROM tags WHERE name = ?", (t,)).fetchone()
                if t_row:
                    conn.execute(
                        "INSERT OR IGNORE INTO entry_tags (entry_id, tag_id) VALUES (?, ?)",
                        (entry_id, t_row["id"]),
                    )
        else:
            tag_col = "tag_name" if "tag_name" in et_cols else ("tag" if "tag" in et_cols else None)
            if tag_col:
                for t in clean_tags:
                    conn.execute(
                        f"INSERT OR IGNORE INTO entry_tags (entry_id, {tag_col}) VALUES (?, ?)",
                        (entry_id, t),
                    )

    if "tags" in entry_cols:
        conn.execute("UPDATE entries SET tags = ? WHERE id = ?", (json.dumps(clean_tags), entry_id))


def get_tag_counts(conn: sqlite3.Connection, media_type: str = "") -> list[dict[str, Any]]:
    tables = get_table_names(conn)
    entry_cols = get_column_names(conn, "entries")

    if "entry_tags" in tables:
        et_cols = get_column_names(conn, "entry_tags")
        if "tag_id" in et_cols and "tags" in tables:
            if media_type and "media_type" in entry_cols:
                rows = conn.execute(
                    """
                    SELECT LOWER(TRIM(t.name)) AS name, COUNT(*) AS count
                    FROM tags t
                    JOIN entry_tags et ON et.tag_id = t.id
                    JOIN entries e ON e.id = et.entry_id
                    WHERE e.media_type = ? AND TRIM(t.name) != ''
                    GROUP BY LOWER(TRIM(t.name))
                    ORDER BY count DESC, name ASC
                    """,
                    (media_type,),
                ).fetchall()
            else:
                rows = conn.execute(
                    """
                    SELECT LOWER(TRIM(t.name)) AS name, COUNT(*) AS count
                    FROM tags t
                    JOIN entry_tags et ON et.tag_id = t.id
                    WHERE TRIM(t.name) != ''
                    GROUP BY LOWER(TRIM(t.name))
                    ORDER BY count DESC, name ASC
                    """
                ).fetchall()
            return [{"name": r["name"], "count": r["count"]} for r in rows]

        tag_col = "tag_name" if "tag_name" in et_cols else ("tag" if "tag" in et_cols else None)
        if tag_col:
            if media_type and "media_type" in entry_cols:
                rows = conn.execute(
                    f"""
                    SELECT LOWER(TRIM(et.{tag_col})) AS name, COUNT(*) AS count
                    FROM entry_tags et
                    JOIN entries e ON e.id = et.entry_id
                    WHERE e.media_type = ? AND TRIM(et.{tag_col}) != ''
                    GROUP BY LOWER(TRIM(et.{tag_col}))
                    ORDER BY count DESC, name ASC
                    """,
                    (media_type,),
                ).fetchall()
            else:
                rows = conn.execute(
                    f"""
                    SELECT LOWER(TRIM({tag_col})) AS name, COUNT(*) AS count
                    FROM entry_tags
                    WHERE TRIM({tag_col}) != ''
                    GROUP BY LOWER(TRIM({tag_col}))
                    ORDER BY count DESC, name ASC
                    """
                ).fetchall()
            return [{"name": r["name"], "count": r["count"]} for r in rows]

    if "tags" in entry_cols:
        if media_type and "media_type" in entry_cols:
            rows = conn.execute("SELECT tags FROM entries WHERE media_type = ?", (media_type,)).fetchall()
        else:
            rows = conn.execute("SELECT tags FROM entries").fetchall()

        counts: dict[str, int] = {}
        for r in rows:
            for t in json.loads(r["tags"] or "[]"):
                tl = t.strip().lower()
                if tl:
                    counts[tl] = counts.get(tl, 0) + 1
        return [{"name": k, "count": v} for k, v in sorted(counts.items(), key=lambda kv: (-kv[1], kv[0]))]

    return []


# --- HTML METADATA SCRAPER ---
class MetaScraper(HTMLParser):
    def __init__(self) -> None:
        super().__init__()
        self.in_title = False
        self.title_chunks: list[str] = []
        self.description = ""
        self.og_image = ""

    def handle_starttag(self, tag: str, attrs: list[tuple[str, Optional[str]]]) -> None:
        attr_map = {k.lower(): (v or "") for k, v in attrs}
        if tag.lower() == "title":
            self.in_title = True
        elif tag.lower() == "meta":
            prop = attr_map.get("property", "").lower()
            name = attr_map.get("name", "").lower()
            content = attr_map.get("content", "").strip()
            if not content:
                return
            if prop == "og:title" and not self.title_chunks:
                self.title_chunks = [content]
            elif (prop == "og:description" or name == "description") and not self.description:
                self.description = content
            elif prop in ("og:image", "twitter:image") and not self.og_image:
                self.og_image = content

    def handle_endtag(self, tag: str) -> None:
        if tag.lower() == "title":
            self.in_title = False

    def handle_data(self, data: str) -> None:
        if self.in_title:
            self.title_chunks.append(data)


def extract_domain(url: Optional[str]) -> Optional[str]:
    if not url:
        return None
    parsed = urllib.parse.urlparse(url if "://" in url else f"https://{url}")
    host = parsed.netloc.lower()
    return host[4:] if host.startswith("www.") else (host or None)


def download_image_to_vault(image_url: str) -> Optional[str]:
    try:
        req = urllib.request.Request(image_url, headers={"User-Agent": "Mozilla/5.0 SHELTR-Vault/1.0"})
        with urllib.request.urlopen(req, timeout=10) as resp:
            content_type = resp.headers.get("Content-Type", "")
            if not content_type.startswith("image/"):
                return None
            ext = mimetypes.guess_extension(content_type.split(";")[0].strip()) or ".jpg"
            if ext == ".jpe":
                ext = ".jpg"
            filename = f"{uuid.uuid4().hex}{ext}"
            dest = VAULT_MEDIA_DIR / filename
            dest.write_bytes(resp.read())
            return f"/vault_media/{filename}"
    except Exception:
        return None


def scrape_url(url: str) -> tuple[str, str, Optional[str]]:
    normalized = url if "://" in url else f"https://{url}"
    fallback_title = extract_domain(normalized) or normalized
    try:
        req = urllib.request.Request(normalized, headers={"User-Agent": "Mozilla/5.0 SHELTR-Vault/1.0"})
        with urllib.request.urlopen(req, timeout=10) as resp:
            raw_bytes = resp.read(512_000)
            html = raw_bytes.decode("utf-8", errors="ignore")
        parser = MetaScraper()
        parser.feed(html)
        title = re.sub(r"\s+", " ", "".join(parser.title_chunks)).strip() or fallback_title
        desc = re.sub(r"\s+", " ", parser.description).strip()
        cover_path = None
        if parser.og_image:
            abs_img = urllib.parse.urljoin(normalized, parser.og_image)
            cover_path = download_image_to_vault(abs_img)
        return title, desc, cover_path
    except Exception:
        return fallback_title, "", None


def normalize_cover_path(path: Optional[str]) -> Optional[str]:
    if not path:
        return None
    clean = path.strip()
    if not clean:
        return None
    if clean.startswith(("http://", "https://", "data:", "/")):
        return clean
    if clean.startswith(("media/", "vault_media/", "covers/")):
        return f"/{clean}"
    return f"/vault_media/{clean}"


def resolve_media_file(filename: str) -> Optional[Path]:
    clean_rel = Path(filename)
    if clean_rel.is_absolute() or ".." in clean_rel.parts:
        return None
    for base_dir in MEDIA_SEARCH_DIRS:
        if not base_dir.exists():
            continue
        candidate = (base_dir / clean_rel).resolve()
        try:
            candidate.relative_to(base_dir.resolve())
        except ValueError:
            continue
        if candidate.is_file():
            return candidate
    return None


def row_to_entry(conn: sqlite3.Connection, row: sqlite3.Row) -> dict[str, Any]:
    keys = set(row.keys())
    raw_meta = row["metadata_json"] if "metadata_json" in keys else (row["metadata"] if "metadata" in keys else "{}")
    try:
        meta_obj = json.loads(raw_meta or "{}")
    except Exception:
        meta_obj = {}

    created_at = row["created_at"] if "created_at" in keys else utc_now()
    updated_at = (row["updated_at"] if "updated_at" in keys else None) or created_at
    raw_cover = row["cover_path"] if "cover_path" in keys else None

    return {
        "id": row["id"],
        "title": row["title"],
        "url": row["url"] if "url" in keys else None,
        "domain": row["domain"] if "domain" in keys else None,
        "media_type": (row["media_type"] if "media_type" in keys else "") or "",
        "status": (row["status"] if "status" in keys else "QUEUED") or "QUEUED",
        "thumb_rating": int((row["thumb_rating"] if "thumb_rating" in keys else 0) or 0),
        "tags": get_entry_tags(conn, row),
        "notes": (row["notes"] if "notes" in keys else "") or "",
        "cover_path": normalize_cover_path(raw_cover),
        "metadata": meta_obj,
        "created_at": created_at,
        "updated_at": updated_at,
        "consumed_at": row["consumed_at"] if "consumed_at" in keys else None,
    }


def filter_entries_in_memory(
    entries: list[dict[str, Any]],
    q: str = "",
    tag: str = "",
) -> list[dict[str, Any]]:
    results = entries

    if q.strip():
        needle = q.strip().lower()
        results = [
            e
            for e in results
            if needle in e["title"].lower()
            or needle in e["notes"].lower()
            or needle in (e["domain"] or "").lower()
            or any(needle in t.lower() for t in e["tags"])
            or needle in json.dumps(e["metadata"]).lower()
        ]

    if tag.strip():
        req_tags = [t.strip().lower().lstrip("#") for t in tag.split(",") if t.strip()]
        if req_tags:
            results = [
                e
                for e in results
                if all(req in [t.lower() for t in e["tags"]] for req in req_tags)
            ]

    return results


def query_filtered_entries(
    conn: sqlite3.Connection,
    q: str = "",
    media_type: str = "ALL",
    status: str = "ALL",
    rating: int = -1,
    tag: str = "",
    sort_by: str = "updated_at",
    sort_dir: str = "DESC",
) -> list[dict[str, Any]]:
    entry_cols = get_column_names(conn, "entries")
    allowed_sort = {
        "updated_at",
        "created_at",
        "title",
        "thumb_rating",
        "domain",
        "media_type",
        "status",
        "consumed_at",
    } & entry_cols
    col = sort_by if sort_by in allowed_sort else ("updated_at" if "updated_at" in entry_cols else "created_at")
    direction = "ASC" if sort_dir.upper() == "ASC" else "DESC"

    clauses: list[str] = []
    params: list[Any] = []

    if media_type and media_type != "ALL" and "media_type" in entry_cols:
        clauses.append("media_type = ?")
        params.append(media_type)

    if status and status != "ALL" and "status" in entry_cols:
        clauses.append("status = ?")
        params.append(status)

    if rating >= 0 and "thumb_rating" in entry_cols:
        clauses.append("thumb_rating = ?")
        params.append(rating)

    where_sql = f"WHERE {' AND '.join(clauses)}" if clauses else ""
    fallback_col = "created_at" if "created_at" in entry_cols else "id"
    order_sql = f"ORDER BY COALESCE({col}, '') COLLATE NOCASE {direction}, {fallback_col} DESC"

    rows = conn.execute(f"SELECT * FROM entries {where_sql} {order_sql}", params).fetchall()
    entries = [row_to_entry(conn, r) for r in rows]
    return filter_entries_in_memory(entries, q=q, tag=tag)


