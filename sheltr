@app.patch("/api/entries/{entry_id}")
def update_entry(entry_id: str, payload: EntryPatch):
    with get_db() as conn:
        existing = conn.execute("SELECT * FROM entries WHERE id = ?", (entry_id,)).fetchone()
        if not existing:
            raise HTTPException(status_code=404, detail="Entry not found")

        entry_cols = get_column_names(conn, "entries")
        now = utc_now()
        updates: dict[str, Any] = {}

        if payload.title is not None:
            updates["title"] = payload.title.strip()

        if payload.url is not None:
            url = payload.url.strip() or None
            if url and "://" not in url:
                url = f"https://{url}"
            updates["url"] = url
            updates["domain"] = extract_domain(url)

        if payload.media_type is not None:
            updates["media_type"] = payload.media_type

        if payload.status is not None:
            updates["status"] = payload.status
            existing_consumed = existing["consumed_at"] if "consumed_at" in entry_cols else None
            if payload.status == "CONSUMED" and not existing_consumed:
                updates["consumed_at"] = now
            elif payload.status != "CONSUMED":
                updates["consumed_at"] = None

        if payload.thumb_rating is not None:
            updates["thumb_rating"] = payload.thumb_rating

        if payload.notes is not None:
            updates["notes"] = payload.notes

        if payload.clear_cover:
            updates["cover_path"] = None
        elif payload.cover_path is not None:
            updates["cover_path"] = payload.cover_path

        updates["updated_at"] = now

        filtered = {k: v for k, v in updates.items() if k in entry_cols}
        if filtered:
            set_sql = ", ".join(f"{k} = ?" for k in filtered.keys())
            conn.execute(f"UPDATE entries SET {set_sql} WHERE id = ?", [*filtered.values(), entry_id])

        if payload.tags is not None:
            clean_tags = list(dict.fromkeys(t.strip().lower().lstrip("#") for t in payload.tags if t.strip()))
            set_entry_tags(conn, entry_id, clean_tags)

        row = conn.execute("SELECT * FROM entries WHERE id = ?", (entry_id,)).fetchone()
        return row_to_entry(conn, row)


