def utc_now() -> str:
    return datetime.now(timezone.utc).isoformat()


def get_db() -> sqlite3.Connection:
    conn = sqlite3.connect(DB_PATH)
    conn.row_factory = sqlite3.Row
    conn.execute("PRAGMA foreign_keys = ON;")
    return conn


def get_table_names(conn: sqlite3.Connection) -> set[str]:
    rows = conn.execute("SELECT name FROM sqlite_master WHERE type='table'").fetchall()
    return {r["name"] for r in rows}


def get_column_names(conn: sqlite3.Connection, table: str) -> set[str]:
    rows = conn.execute(f"PRAGMA table_info({table})").fetchall()
    return {r["name"] for r in rows}


def init_db() -> None:
    with get_db() as conn:
        tables = get_table_names(conn)

        if "media_types" not in tables:
            conn.execute(
                """
                CREATE TABLE media_types (
                    name TEXT PRIMARY KEY,
                    color TEXT DEFAULT '#818cf8'
                )
                """
            )
        else:
            mt_cols = get_column_names(conn, "media_types")
            if "color" not in mt_cols:
                conn.execute("ALTER TABLE media_types ADD COLUMN color TEXT DEFAULT '#818cf8'")

        if "entries" not in tables:
            conn.execute(
                """
                CREATE TABLE entries (
                    id TEXT PRIMARY KEY,
                    title TEXT NOT NULL,
                    url TEXT,
                    domain TEXT,
                    media_type TEXT DEFAULT '',
                    status TEXT DEFAULT 'QUEUED',
                    thumb_rating INTEGER DEFAULT 0,
                    tags TEXT DEFAULT '[]',
                    notes TEXT DEFAULT '',
                    cover_path TEXT,
                    metadata TEXT DEFAULT '{}',
                    created_at TEXT NOT NULL,
                    updated_at TEXT NOT NULL,
                    consumed_at TEXT
                )
                """
            )
        else:
            entry_cols = get_column_names(conn, "entries")
            for col_name, col_def in [
                ("domain", "TEXT"),
                ("media_type", "TEXT DEFAULT ''"),
                ("status", "TEXT DEFAULT 'QUEUED'"),
                ("thumb_rating", "INTEGER DEFAULT 0"),
                ("notes", "TEXT DEFAULT ''"),
                ("cover_path", "TEXT"),
                ("updated_at", "TEXT"),
                ("consumed_at", "TEXT"),
            ]:
                if col_name not in entry_cols:
                    conn.execute(f"ALTER TABLE entries ADD COLUMN {col_name} {col_def}")

            if "metadata" not in entry_cols and "metadata_json" not in entry_cols:
                conn.execute("ALTER TABLE entries ADD COLUMN metadata TEXT DEFAULT '{}'")

            if "entry_tags" not in tables and "tags" not in entry_cols:
                conn.execute("ALTER TABLE entries ADD COLUMN tags TEXT DEFAULT '[]'")

            if "created_at" in entry_cols:
                conn.execute(
                    "UPDATE entries SET updated_at = created_at WHERE updated_at IS NULL OR updated_at = ''"
                )

        if "saved_searches" not in tables:
            conn.execute(
                """
                CREATE TABLE saved_searches (
                    id TEXT PRIMARY KEY,
                    name TEXT NOT NULL,
                    query TEXT DEFAULT '',
                    include_filters INTEGER DEFAULT 0,
                    media_type TEXT DEFAULT 'ALL',
                    status TEXT DEFAULT 'ALL',
                    rating INTEGER DEFAULT -1,
                    tag TEXT DEFAULT '',
                    sort_by TEXT DEFAULT 'updated_at',
                    sort_dir TEXT DEFAULT 'DESC'
                )
                """
            )
        else:
            ss_cols = get_column_names(conn, "saved_searches")
            for col_name, col_def in [
                ("query", "TEXT DEFAULT ''"),
                ("include_filters", "INTEGER DEFAULT 0"),
                ("media_type", "TEXT DEFAULT 'ALL'"),
                ("status", "TEXT DEFAULT 'ALL'"),
                ("rating", "INTEGER DEFAULT -1"),
                ("tag", "TEXT DEFAULT ''"),
                ("sort_by", "TEXT DEFAULT 'updated_at'"),
                ("sort_dir", "TEXT DEFAULT 'DESC'"),
            ]:
                if col_name not in ss_cols:
                    conn.execute(f"ALTER TABLE saved_searches ADD COLUMN {col_name} {col_def}")

        count = conn.execute("SELECT COUNT(*) FROM media_types").fetchone()[0]
        if count == 0:
            defaults = [
                ("VIDEOS", "#818cf8"),
                ("ARTICLES", "#38bdf8"),
                ("BOOKS", "#d97757"),
                ("MUSIC", "#c084fc"),
                ("GAMES", "#fb7185"),
            ]
            conn.executemany("INSERT INTO media_types (name, color) VALUES (?, ?)", defaults)


