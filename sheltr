def resolve_paths() -> tuple[Path, Path, Path, list[Path], Path]:
    script_dir = Path(__file__).resolve().parent
    cwd = Path.cwd()
    candidates = [
        script_dir,
        script_dir / "SHELTR_VAULT",
        cwd,
        cwd / "SHELTR_VAULT",
    ]

    # Locate UI directory
    ui_dir = script_dir / "ui"
    for base in candidates:
        if (base / "ui" / "index.html").exists():
            ui_dir = base / "ui"
            break

    # Locate existing sheltr.db or any media directory, otherwise default beside ui/
    data_dir = ui_dir.parent
    for base in candidates:
        if (
            (base / "sheltr.db").exists()
            or (base / "vault_media").exists()
            or (base / "media").exists()
            or (base / "covers").exists()
        ):
            data_dir = base
            break

    db_path = data_dir / "sheltr.db"
    vault_media_dir = data_dir / "vault_media"
    legacy_media_dir = data_dir / "media"
    legacy_covers_dir = data_dir / "covers"
    backups_dir = data_dir / "backups"

    vault_media_dir.mkdir(parents=True, exist_ok=True)
    backups_dir.mkdir(parents=True, exist_ok=True)

    search_dirs: list[Path] = []
    for d in (vault_media_dir, legacy_media_dir, legacy_covers_dir):
        if d not in search_dirs:
            search_dirs.append(d)

    return ui_dir, db_path, vault_media_dir, search_dirs, backups_dir


UI_DIR, DB_PATH, VAULT_MEDIA_DIR, MEDIA_SEARCH_DIRS, BACKUPS_DIR = resolve_paths()

