def insert_entry_record(conn: sqlite3.Connection, values: dict[str, Any], clean_tags: list[str]) -> dict[str, Any]:
    entry_cols = get_column_names(conn, "entries")
    meta_col = get_meta_column(conn)
    if "metadata" in values and meta_col != "metadata":
        values[meta_col] = values.pop("metadata")

    filtered = {k: v for k, v in values.items() if k in entry_cols}
    cols_sql = ", ".join(filtered.keys())
    placeholders = ", ".join(["?"] * len(filtered))
    conn.execute(f"INSERT INTO entries ({cols_sql}) VALUES ({placeholders})", list(filtered.values()))
    set_entry_tags(conn, values["id"], clean_tags)
    row = conn.execute("SELECT * FROM entries WHERE id = ?", (values["id"],)).fetchone()
    return row_to_entry(conn, row)


